rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROP QUESTIONS (Global Seeds)
    match /prop_questions/{questionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // NFL GAMES
    match /nfl_games/{gameId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      // Live win probability (ADR 0004) — public game info, server-written only.
      match /winprob/{docId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // FROZEN NFL SPREADS (PLAN-NFL-SPREAD-FREEZE Revision 1).
    //
    // The line every ATS pool is picked against and graded against, once it has
    // been committed to. `allow write: if false` — NO client may write it, and
    // that includes a SUPER_ADMIN. Not "refused when locked": refused, full stop.
    // A conditional deny is a condition that can be subtly wrong, and this whole
    // collection exists because an invariant defended in four writers kept
    // leaking.
    //
    // The only writers are Cloud Functions, which bypass rules by design: the
    // weekly freeze pass and `overrideLockedSpread`. The Spread Manager keeps
    // writing `nfl_games.spread` as a WORKING line and cannot affect a frozen one.
    //
    // Public read, same as `nfl_games`: the pick sheet renders this value, so a
    // member has to be able to see the number they are graded against.
    match /nfl_frozen_spreads/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // SITE-WIDE CONSENSUS (ADR 0004) — server-written post-lock aggregate (counts only, never
    // individual picks), scoped by pool type. Public read; write server-only.
    match /consensus/{weekKey}/{poolType}/{gameId} {
      allow read: if true;
      allow write: if false;
    }
    match /consensus/{weekKey} {
      allow read: if true;
      allow write: if false;
    }

    // PLAYER PROFILES (ADR 0004/0005) — sanitized public projection (only aggregate + scored
    // data; ZERO pool identifiers; never the private per-user docs). Public read;
    // server-written only.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;

      // ACHIEVEMENTS (ADR 0005 decision 5) — earned-achievement docs written only by the
      // future server-side achievements engine (Admin SDK). Same leak rule as the parent:
      // no pool identifiers on these docs.
      match /achievements/{achievementId} {
        allow read: if true;
        allow write: if false;
      }
    }

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'SUPER_ADMIN';
    }

    // EXPERT RESULTS (ADR 0005 Phase 6) — server-only grading store behind the
    // publicProfiles/expert_* projections. Clients read only the projection.
    match /expertResults/{expertId}/{document=**} {
      allow read, write: if false;
    }

    // POOLS:
    match /pools/{poolId} {
      // Allow GET by anyone (Guest Access via Link)
      allow get: if true;
      
      // Allow LIST (query) ONLY if:
      // 1. It is a single-document query (e.g. slug lookup)
      // 2. The pool is public
      // 3. The user is a participant, owner, or manager
      // 4. The user is a SuperAdmin
      allow list: if (request.query.limit <= 1) || 
                     (resource.data.isPublic == true) || 
                     (request.auth != null && (
                        resource.data.ownerId == request.auth.uid || 
                        resource.data.managerUid == request.auth.uid || 
                        request.auth.uid in resource.data.participantIds ||
                        // Commissioner Hub (PLAN-CO-COMMISSIONERS D7). A LIST rule must be
                        // PROVABLE from the query's own filters, so this is written with
                        // plain field access (no `.get()`), and the Hub query MUST carry
                        // BOTH `where('coManagers','array-contains',uid)` AND
                        // `where('type','in',[the three NFL types])` — the type filter is
                        // what lets the prover discharge the type guard. Measured: the
                        // array-contains filter alone is DENIED (coManagers.rules.test.mjs).
                        (resource.data.type in ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN'] &&
                         request.auth.uid in resource.data.coManagers)
                     )) || 
                     isSuperAdmin();

      // Delete: Owner only OR SuperAdmin
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.managerUid || 
        isSuperAdmin()
      );
      
      // PLAN-CO-COMMISSIONERS T3 (deploy step 3 — ships WITH the setter callable,
      // never before it): a uid named in a server-owned `coManagers` array is a
      // commissioner of an NFL pool. The type guard is enforced here exactly as
      // in functions `isPoolCommissioner` and the client `isNFLPoolCommissioner`
      // — a `coManagers` array on a Squares/Bracket/Props/Playoff pool grants
      // nothing in any layer (codex r3 on the plan). Takes the pool DATA so the
      // subcollection rows can pass their `get()` result.
      function isNFLCoManagerOf(pool) {
        return request.auth != null
          && pool.get('type', '') in ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN']
          && pool.get('coManagers', []) != null
          && request.auth.uid in pool.get('coManagers', []);
      }

      // Helper: is user the pool owner, manager, or (NFL) co-commissioner?
      // ⚠️ WIDENED by PLAN-CO-COMMISSIONERS T3. Callers: the pool `update` rule
      // (co-commissioners edit settings under the SAME protectedFieldsUnchanged /
      // nflSettingsWriteBlocked chain — R2) and nothing else; `delete` below is
      // deliberately inline ownerId/managerUid (C8: destructive stays owner-only).
      function isPoolManager() {
        return request.auth.uid == resource.data.ownerId
          || request.auth.uid == resource.data.managerUid
          || isNFLCoManagerOf(resource.data);
      }

      // Protected fields that ONLY the Admin SDK (cloud functions) can write.
      function protectedFieldsUnchanged() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny([
          'managerUid', 'ownerId', 'createdAt', 'createdBy',
          'axisNumbers', 'squares', 'participants',
          // 🛑 THE ROSTER IS AN AUTHORIZATION INPUT, SO IT IS SERVER-OWNED.
          //
          // `participantIds` decides who may read a pool's PICKS
          // (PLAN-MEMBER-PICKS-VISIBILITY, Kevin's K9 ruling 2026-08-14) via
          // `isProvableMember`. While it stayed client-writable, a manager could
          // add any uid and hand that account a DURABLE, self-refreshing feed of
          // every future pick reveal — not a one-time disclosure they could have
          // made verbally anyway, but a standing capability that outlives their
          // interest in granting it. `participants` was already protected here;
          // `participantIds` — the one every membership check actually reads —
          // was not.
          //
          // Nothing legitimate loses a capability. Pool CREATE is server-only,
          // and every join / rebuy / removal path writes this array through the
          // Admin SDK (`lib/memberRecord.ts`), which bypasses rules entirely.
          // Measured before shipping: ZERO client writes anywhere in `src/`
          // (PLAN-MEMBER-PICKS-VISIBILITY-SWEEPS S4). The wizards' full-object
          // updates still pass, because a same-value write is not an
          // affectedKey — the same reasoning as `type` below.
          'participantIds',
          // 🛑 `coManagers` IS AN AUTHORIZATION INPUT TOO, SO IT IS SERVER-OWNED
          // (PLAN-CO-COMMISSIONERS T1, deploy step 2 of D2). Three callable gates
          // used to trust this array while it sat OUTSIDE this list — an owner
          // could `updateDoc({coManagers:[uid]})` from a browser and hand that
          // uid scoreNFLWeek / recordPoolPayouts / cancelPool. Same hole as
          // `participantIds` above, one field over. `coManagersRevision` rides
          // along: it is the add-vs-remove race fence for the setter callable,
          // and a client-writable revision lets a current co-manager reset it
          // after a remove and slip a stale add through (codex r3).
          //
          // ⚠️ THIS IS A LOCK ONLY. No rule in this file READS `coManagers` yet
          // — the reading predicates ship in T3, in the SAME deploy as the
          // callable that writes it, never in this one. Reading before the
          // audited clear has run would honour a legacy forged array.
          'coManagers', 'coManagersRevision',
          'billing', // Billing status managed exclusively by Cloud Functions
          // Frozen weekly pick deadlines for Survivor/Margin. The server only ever
          // moves these EARLIER; a manager who could clear the map would erase the
          // record of a deadline that already passed and reopen that week by
          // widening the lock buffer.
          'hardLockByWeek',
          // Frozen weekly tiebreak TARGET game ids (PLAN-WEEKLY-PRIZES §2b).
          // Written once per pool-week by the first submitNFLPicks of that week
          // and read by every later sheet and by the scorer; a manager who could
          // rewrite the map could re-point predictions members already made.
          'frozenTiebreakTargets',
          // The frozen weeks divisor of the weekly prize pot (PLAN-WEEKLY-PRIZES
          // D5): written by createPool or set-once by the scorer at first prize
          // publication; a manager who could rewrite it would re-price every
          // future weekly prize.
          'weeksInSeason',
          // The published Season Places + frozen season prize (PLAN-WEEKLY-PRIZES
          // step 3), written by finalization; recordPoolPayouts BINDS season
          // PLACE awards to this list, so a manager who could rewrite it could
          // bind an award to a figure the ranking never produced.
          'seasonPlaces', 'seasonPrize', 'seasonPlacesError',
          // Scorer-owned state (PLAN-REALTIME-SCORING §3a, PR-B′). Every one of
          // these is a field a manager could otherwise use to undo the reveal
          // guarantee or the scoring mutex:
          //   publishedWeeks  — clearing it reopens a week whose result members
          //                     have already seen;
          //   autoScore       — holds the fenced scoring lease and the per-week
          //                     fingerprints; clearing the lease breaks the mutex;
          //   scoredWeeks /
          //   scoredThroughWeek — the finalization completeness markers.
          'publishedWeeks', 'autoScore', 'scoredWeeks', 'scoredThroughWeek',
          // Stats discriminator (PLAN-STATS-INTEGRITY §8.1, arm 3). A pool marked
          // isTestPool is excluded from every published money figure, so a manager
          // who could WRITE it could hide their own pool's volume, and one who
          // could CLEAR it could push a test pool's fake pot into the
          // world-readable stats/global document. Kevin sets it as data (console /
          // Admin SDK, which bypass rules) when labelling legacy test pools.
          //
          // `simRunId` rides along for the same reason: it is arm 1 of the same
          // discriminator AND the sim-harness trust anchor. It is already stripped
          // from every client CREATE payload (poolOps.ts PRIVILEGED_POOL_FIELDS);
          // leaving it writable on UPDATE reopened that hole with one extra step.
          // Nothing client-side writes it — the server stamps it for SUPER_ADMIN
          // callers only.
          'isTestPool', 'simRunId',
          // The pool TYPE decides which rules apply to it, so a manager who could
          // change it could step out of every type-scoped protection and back in.
          // Concretely (codex r1): flip an NFL pool to SQUARES, write
          // settings.weekLockOverrides while nflSettingsWriteBlocked() no longer
          // fires, flip it back — reopening a published week's deadline. Nothing
          // legitimately rewrites `type` after creation; a same-value write is not
          // an affectedKey, so the wizards' full-object updates still pass.
          'type'
        ]);
      }

      // NFL pool settings are SERVER-ONLY (PLAN-REALTIME-SCORING §3a, codex
      // r12/r13). A nested-field allowlist cannot do this job: the manager UI
      // sends a COMPLETE `settings` replacement and `affectedKeys()` only reports
      // the top-level `settings` key, so an override injected inside a wholesale
      // settings write is invisible to any per-field rule. Denying the key
      // outright and routing edits through the `updatePoolSettings` callable —
      // which merges per key and refuses the server-owned ones — is what actually
      // closes it.
      //
      // Scoped to NFL pools because they are the ones scored live game-by-game;
      // bracket/squares/props settings keep their existing client path.
      //
      // Checks BOTH the stored and the incoming type. `type` is protected above,
      // so they cannot legitimately differ — testing both is defence in depth
      // against a future rule that relaxes that protection.
      function nflSettingsWriteBlocked() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let nflTypes = ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN'];
        let isNfl = resource.data.get('type', '') in nflTypes
                    || request.resource.data.get('type', '') in nflTypes;
        return !isNfl || !changed.hasAny(['settings']);
      }

      // `seasonType` is arm 2 of the stats test-pool discriminator
      // (PLAN-STATS-INTEGRITY §8.1): an NFL season pool on seasonType 1 is
      // preseason, i.e. Kevin's own testing, and counts toward nothing. So a
      // manager who can write it can move a real regular-season pool out of every
      // published money figure — and back in. Found by codex r1 on PR A.
      //
      // NOT added to protectedFieldsUnchanged(), which is unscoped: the SQUARES
      // setup wizard legitimately rewrites `seasonType` on an existing pool when
      // the commissioner re-picks the game (AdminPanel.tsx selectGame ->
      // updateConfig -> dbService.updatePool). Freezing it everywhere would break
      // that save. The discriminator only READS seasonType on NFL season pools, so
      // that is the only place it needs freezing.
      //
      // Same both-sides type check as nflSettingsWriteBlocked(), and for the same
      // reason: `type` is protected above, so they cannot legitimately differ.
      function nflSeasonTypeWriteBlocked() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let nflTypes = ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN'];
        let isNfl = resource.data.get('type', '') in nflTypes
                    || request.resource.data.get('type', '') in nflTypes;
        return !isNfl || !changed.hasAny(['seasonType']);
      }

      // Arm 1 of the stats discriminator also reads a `sim-` SEASON prefix
      // (shared/testPool.ts isSimPool). A manager of an OPEN pool could otherwise
      // rewrite `season` to `sim-anything` and drop their own paid pool out of
      // every published money figure — and out of the sim-aware scoring paths that
      // already skip sim pools (nflAutoScore, nflLockWatch, the finalize sweep),
      // which is the older and worse half of the same hole. Found by codex r2.
      //
      // A blanket freeze on `season` would be wrong: it rides along in the
      // full-object update the Props wizard sends (PropsWizard.tsx UPDATE MODE).
      // Only the TRANSITION INTO a sim- value is denied. A same-value write is not
      // an affectedKey, so an unchanged season never reaches this check at all.
      //
      // A changed `season` must be a STRING or a NUMBER. Numbers are allowed
      // because a wizard may persist a legacy numeric year and no number
      // stringifies to a sim- prefix. Everything else — list, map, bool — is
      // DENIED, because JS coercion makes them forgeable: `String(['sim-x'])` is
      // exactly `'sim-x'`, so a Firestore array value sails past a string-only
      // check here and is then classified as a sim pool by isSimPool, taking the
      // pool out of nflAutoScore, nflLockWatch and the finalize sweep. Found by
      // codex r4; the JS side now also requires a string, so the trick is dead at
      // both ends.
      //
      // Only the server stamps a legitimate sim- season — the harness creates
      // through the Admin SDK create callables, which rules never see.
      //
      // `(?s)` IS LOAD-BEARING, not decoration (codex r3). matches() is a RE2
      // FULL-string match, and RE2's `.` does not match a newline by default — so
      // a bare 'sim-.*' returns FALSE for the value "sim-\nanything", which this
      // rule would then have allowed. isSimPool would still classify it as a test
      // pool, because it only does String(season).startsWith('sim-'). The inline
      // (?s) flag makes `.` match newlines and closes that bypass.
      function seasonNotForgedSim() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let s = request.resource.data.get('season', '');
        return !changed.hasAny(['season'])
               || (s is string && !s.matches('(?s)sim-.*'))
               || s is int
               || s is float;
      }

      // These settings are CALLABLE-ONLY, for EVERY client principal including
      // SUPER_ADMIN (PLAN-SURVIVOR-PARITY-SCORING decision 4;
      // PLAN-WEEKLY-TIEBREAKERS §5).
      //
      // `updatePoolSettings` refuses to change either field once the pool has
      // published a scored week, because both regrade past weeks on the next
      // rescore. A direct client write skips that refusal entirely, and
      // `firestore.rules:242` grants isSuperAdmin() unrestricted pool updates —
      // so without this the gate is one console-adjacent write away from being
      // decorative.
      //
      // ⚠️ THE NESTED DIFF IS THE POINT. Root-level
      // `request.resource.data.diff(resource.data).affectedKeys()` reports only
      // the top-level `settings` key — documented at the nflSettingsWriteBlocked()
      // comment above and at poolUpdate.ts's flatten helper — so a per-field check
      // written against the ROOT diff would never fire and this rule would read as
      // a guard while guarding nothing. Diffing the settings MAPS catches all
      // three shapes: a dotted `settings.maxTeamUses` update, a wholesale
      // `settings` replacement with the value changed inside it, and a deletion.
      //
      // Applied OUTSIDE the super-admin disjunction below, deliberately. Scoped to
      // these two fields, also deliberately: a blanket SA lockout of NFL settings
      // would change the repair surface for every other field, which is a bigger
      // blast radius than the bypass being closed. Privileged edits go through the
      // gated callable.
      //
      // Admin-SDK and console writes bypass rules by nature; they carry the same
      // invariant by convention, not by enforcement.
      //
      // ⚠️ `weeklyTiebreaker` JOINED THIS LIST FOR EXACTLY THE SAME REASON, and
      // it was nearly missed. `updatePoolSettings` refuses to change the weekly
      // tie-breaker rule once anybody has submitted a sheet, because the number
      // members already typed was an answer to the OLD question — and under the
      // `NONE` rule they were never asked at all, so the scorer would read every
      // one of them as having predicted 0.
      //
      // The plan for that change asserted the opposite of what this file does:
      // it read `nflSettingsWriteBlocked()` and concluded NFL settings were
      // denied to every client principal, so no rules work was owed. They are
      // denied to MANAGERS. `nflSettingsWriteBlocked()` lives INSIDE the
      // isPoolManager() branch of the disjunction below, and `isSuperAdmin()`
      // short-circuits past it. Only the nested check in this function applies
      // to both. (codex, on the implementation PR.)
      function callableOnlySettingsUnchanged() {
        let changed = request.resource.data.get('settings', {})
                        .diff(resource.data.get('settings', {}))
                        .affectedKeys();
        let nflTypes = ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN'];
        let isNfl = resource.data.get('type', '') in nflTypes
                    || request.resource.data.get('type', '') in nflTypes;
        // entryFee/payoutMode join the guard ON NFL POOLS ONLY: a direct write
        // to either can unbalance a stored hybridSplit the callable would have
        // refused (codex P1 on the split PR). Scoped to NFL because other pool
        // types legitimately edit fee fields through non-callable admin paths.
        // maxEntriesPerUser joins the NFL-ONLY clause (PLAN-MULTI-ENTRY D8):
        // raise-only through the callable — a direct write could LOWER it under
        // a member who already holds three entries. NFL-scoped because Bracket
        // and Playoff carry the SAME key and save it by direct updateDoc
        // (BracketPoolDashboard handleSaveSettings, SuperAdmin) — an unscoped
        // deny broke every Bracket settings save (qodo #1 on #449).
        // `weeklyPayouts` (PLAN-PAYMENT-LEDGER T1): the validator lives in the
        // callable, so no direct write — SUPER_ADMIN clients included — may bypass it.
        return !changed.hasAny(['tieCountsAs', 'maxTeamUses', 'weeklyTiebreaker', 'hybridSplit', 'weeklyPayouts'])
               // `payouts` (PLAN-PAYMENT-LEDGER T1 / K9): the unique-rank + ≤100 %
               // validation lives in updatePoolSettings; a SUPER_ADMIN client
               // bypasses nflSettingsWriteBlocked(), so without this line a
               // direct write could persist a duplicate rank the scorer then
               // fails closed on (codex r2 on #470). NFL only — Bracket/Playoff
               // managers still edit payouts directly.
               && (!isNfl || !changed.hasAny(['entryFee', 'payoutMode', 'maxEntriesPerUser', 'payouts']));
      }

      // Pool is in an editable state.
      // NOTE: 'PUBLISHED' is removed — status was renamed to 'OPEN'.
      function poolIsEditable() {
        return resource.data.get('status', 'DRAFT') in ['DRAFT', 'OPEN'];
      }

      // Is the caller a participant of this pool? (owner, manager, listed
      // participant, or SuperAdmin). Used to scope pool sub-resources (audit M2).
      function isPoolParticipant() {
        let pool = get(/databases/$(database)/documents/pools/$(poolId)).data;
        return request.auth != null && (
          pool.ownerId == request.auth.uid ||
          pool.managerUid == request.auth.uid ||
          (pool.get('participantIds', []) != null && request.auth.uid in pool.get('participantIds', [])) ||
          isSuperAdmin()
        );
      }

      // Update: Owner/Manager (filtered) OR SuperAdmin (unrestricted) — except
      // the callable-only settings, which NO client principal may write.
      //
      // ⚠️ THE POSITION OF THIS CALL IS THE WHOLE GUARD. It sits OUTSIDE the
      // disjunction, so it applies to the super-admin branch too. Every other
      // settings protection — `nflSettingsWriteBlocked()` included — is inside
      // the manager branch and is short-circuited by `isSuperAdmin()`.
      allow update: if request.auth != null && callableOnlySettingsUnchanged() && (
        (isPoolManager() && protectedFieldsUnchanged() && nflSettingsWriteBlocked() && nflSeasonTypeWriteBlocked() && seasonNotForgedSim() && poolIsEditable())
        || isSuperAdmin()
      );
                    
      // NO CREATE via Client (must use createPool function). The former sim-*
      // slug SUPER_ADMIN exception is GONE (PLAN-NFL-SIM-HARNESS Phase 5): every
      // simulator now creates through the real create callables with a
      // server-stamped simRunId trust anchor — no client path may mint pool docs.
      allow create: if false;

      // WINNERS (Subcollection)
      match /winners/{winnerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // PAYMENT LEDGER (Subcollection) — append-only money audit trail.
      // Members of the pool can read it (shared record prevents "I paid you"
      // disputes); ALL writes go through Cloud Functions.
      match /payments/{paymentId} {
        allow read: if isPoolParticipant();
        allow write: if false; // Only via Cloud Functions
      }

      // PARTICIPANTS INDEX (Subcollection)
      match /participants/{participantId} {
        allow read: if request.auth != null && (
          request.auth.uid == participantId || 
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false; // Only via Cloud Functions
      }

      // SQUARE PRIVATE (Player PII — audit finding H1)
      // Contact info (email/phone/etc) is kept OUT of the public pool doc and
      // stored here so it is never exposed by the broad guest-link `get`.
      // Readable only by the pool owner/manager or a SuperAdmin. Writes are
      // Cloud Functions only (reserveSquare / updatePlayer / releaseSquares).
      match /squarePrivate/{squareId} {
        // Squares PII stays owner/managerUid/SA — PLAN-CO-COMMISSIONERS K7 = No
        // (and co-commissioners are NFL-only in v1 anyway, C13).
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false; // Only via Cloud Functions
      }

      // AUDIT LOGS
      match /audit/{auditId} {
        // Restrict reads to pool owner or super admin (audit logs contain UIDs and operation metadata)
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isNFLCoManagerOf(get(/databases/$(database)/documents/pools/$(poolId)).data) ||
          isSuperAdmin()
        );
        allow write, delete: if false; 
      }

      // AI COMMISSIONER
      match /ai_artifacts/{docId} {
        allow read: if true;
        allow write: if false;
      }
      
      match /ai_requests/{docId} {
         // Scoped to pool participants — requests can contain prompt/user context (audit M2).
         allow read: if isPoolParticipant();
         allow create: if request.auth != null
                       && request.resource.data.userId == request.auth.uid;
         allow update, delete: if false;
      }

      // ANNOUNCEMENTS
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isNFLCoManagerOf(get(/databases/$(database)/documents/pools/$(poolId)).data) ||
          isSuperAdmin()
        );
      }

      // BANTER MESSAGES
      // Reads scoped to pool participants (audit M2). authorUid must match the
      // authenticated user to prevent identity spoofing.
      match /messages/{messageId} {
        allow read: if isPoolParticipant();
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // PROP CARDS
      match /propCards/{userId} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin();
      }

      // WEEKLY RECAPS
      match /weekly_recaps/{recapId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // BRACKET/PLAYOFF/NFL ENTRIES
      // A member always reads their OWN entry; SUPER_ADMIN reads everything.
      //
      // ⚠️ THE POOL'S OWNER AND managerUid ARE DELIBERATELY NOT LISTED HERE
      // (PLAN-COMMISSIONER-BLIND-PICKS T3, 2026-08-12). They used to be, which
      // meant a commissioner read every member's picks before kickoff — Kevin:
      // "Pool commissioners should not see picks until pool lock. Only superadmin
      // should have the ability to see all picks at all times."
      //
      // An entry document bundles EVERY week's picks, so no document-level rule
      // can say "week 4 yes, week 5 no". Commissioner reads therefore go through
      // the `getPoolPicks` callable, which has a server-side clock and assembles
      // its response by allowlist of revealed game ids. Do not re-add them here
      // to fix a manager surface: that reopens the whole season, for every week.
      //
      // Non-owner PARTICIPANT reads split by pool type (ADR 0004 finding, closed by ADR 0005
      // Phase 2):
      // - NFL season types (PER_GAME/WEEKLY lock): an entry doc bundles ALL of a member's
      //   picks, so any pre-FINAL read can expose un-locked later picks. Participants read
      //   the server standings projection (/standings/current) and consensus instead; raw
      //   entries open up only when the pool is FINAL/COMPLETED.
      // - Single-lock types (bracket/playoff): post-lock full reveal is by design — the
      //   coarse locked/live gate stays.
      match /entries/{entryId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.ownerUid ||
          isSuperAdmin() ||
          (
            request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds &&
            (
              get(/databases/$(database)/documents/pools/$(poolId)).data.type in ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN']
                ? (
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'FINAL' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'COMPLETED'
                  )
                : (
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'LOCKED' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'LIVE' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'FINAL' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'COMPLETED' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.isLocked == true
                  )
            )
          )
        );
        // Entries are written SERVER-SIDE ONLY (bracketEntries/poolOps callables;
        // simulators go through the runId-scoped simWriteEntries harness). The
        // former blanket isSuperAdmin() write — the Test Suite's raw-write door,
        // one bug away from corrupting a real pool's entries — is GONE
        // (PLAN-NFL-SIM-HARNESS Phase 5).
        allow write: if false;
      }

      // MEMBER RECORDS (roster + payment truth, ADR 0003)
      // Readable by any member of the pool + owner/manager/admin. Members may set ONLY
      // their own honor-system claim (memberReportedPaid/memberReportedAt) — the diff is
      // pinned so paidStatus and every other field stay server-only. Records are created
      // and deleted server-side (reconcileMembership / backfill migration).
      match /members/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.uid == memberUid ||
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow update: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberReportedPaid', 'memberReportedAt']);
        allow create, delete: if false;
      }

      // STANDINGS PROJECTION (ADR 0005 Phase 2) — member-readable, reveal-safe scored
      // rows written by scoreNFLWeek (allowlist-built: no picks/confidence/usedTeams).
      // This is what member views read now that raw NFL entry reads are own-only pre-FINAL.
      match /standings/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // PAYOUT RECORDS (ADR 0005 Phase 4) — who-won-what, the source of truth for
      // Profit. Participant-readable (a pool's winners are inherent to pool play);
      // written only by the recordPoolPayouts callable.
      match /payoutRecords/{awardId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          // A named NFL co-commissioner runs the ledger (PLAN-PAYMENT-LEDGER T5;
          // the callable admits them) — same predicate the private records use.
          isNFLCoManagerOf(get(/databases/$(database)/documents/pools/$(poolId)).data) ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // Settlement state, notes, and actor metadata are NOT pool-public: only the
      // commissioner/manager/admin and the affected recipient may read.
      match /payoutRecordsPrivate/{awardId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isNFLCoManagerOf(get(/databases/$(database)/documents/pools/$(poolId)).data) ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // ROSTER SUMMARY (member-readable dues projection; server-written only)
      match /rosterSummary/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // POOL CONSENSUS (ADR 0004) — server-written post-lock aggregate (counts only, no
      // individual picks). Readable by the pool's members/owner/admin; write server-only.
      match /consensus/{gameId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // SHARE CLICK TRACKING
      // Records share link clicks for pool manager analytics.
      // Writes require auth to prevent anonymous flooding.
      // Reads restricted to pool owner/super admin.
      match /shareClicks/{clickId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isNFLCoManagerOf(get(/databases/$(database)/documents/pools/$(poolId)).data) ||
          isSuperAdmin()
        );
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
    
    // USERS & PARTICIPATIONS:
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      allow write: if request.auth != null && (
        (request.auth.uid == userId && (
          // Self-create default role. MEMBER is canonical (T6); PARTICIPANT kept
          // during the write-path migration + backfill so no ordering hazard.
          (resource == null && (request.resource.data.role == 'MEMBER' || request.resource.data.role == 'PARTICIPANT')) ||
          (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'referralCredits', 'freePoolsAvailable',
            'poolCredits', 'activeBundleType', 'bundleExpiresAt'
          ]))
        )) ||
        isSuperAdmin()
      );

      // PARTICIPATIONS (Dashboard Index)
      match /participations/{poolId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only via Cloud Functions
      }

      // SEASON HISTORY (career record, written on pool completion)
      match /seasonHistory/{poolId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow write: if false; // Only via Cloud Functions
      }
    }

    // POOL CLAIMS (Cross-Device Merge) — Cloud Functions only
    match /poolClaims/{claimId} {
      allow read, write: if false;
    }

    // SLUGS (For availability check)
    match /slugs/{slug} {
      allow get: if true;
    }

    // GLOBAL CONFIG
    // config/internal holds server-only secrets (email unsubscribe HMAC key) —
    // it must never be client-readable. Cloud Functions use the Admin SDK,
    // which bypasses these rules.
    match /config/{configId} {
      allow read: if configId != 'internal';
      allow write: if isSuperAdmin() && configId != 'internal';
    }

    // EMAIL OPT-OUTS — written only by the emailUnsubscribe function (Admin SDK)
    match /email_optouts/{docId} {
      allow read, write: if false;
    }

    // SYSTEM DOCUMENTS
    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // PLATFORM HEALTH — the health/latest snapshot doc (Overview API Status Center).
    // Written only by functions (getAdminHealthSnapshot callable + scheduledHealthCheck,
    // via Admin SDK, which bypasses rules); readable by SUPER_ADMIN only.
    match /health/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // SYSTEM LOGS
    // Create is functions-only (via the App-Check-gated logClientError callable +
    // server-side loggers, which use the Admin SDK and bypass rules). Previously
    // `create: if request.auth != null` let any authed user inject arbitrary docs
    // into this admin-visible log (log spoofing / stored-content injection).
    match /system_logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ADMIN AUDIT LOG (T7) — forensic trail of admin actions, keyed by actor.
    // Written exclusively by Cloud Functions (writeAdminAudit); read by admins.
    match /admin_audit/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // BILLING CHARGES (T14) — platform revenue ledger (Stripe charges). Sensitive
    // company income, so admin-only read and functions-only write. NOT under the
    // public stats/* — that holds only prize volume/charity.
    match /billingCharges/{chargeId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ADMIN STATS (T14) — SUPER_ADMIN-only aggregates (e.g. revenue rollup).
    match /admin_stats/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // TOURNAMENTS (March Madness Data)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // STATS
    match /stats/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // POOL THEMES
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // EMAIL TRIGGERS — must go through Cloud Functions
    match /mail/{document=**} {
      allow create: if false;
    }

    // COUPONS — SUPER_ADMIN-only reads (ADR-0002): usageLog now holds per-user
    // reservation activity (userId/poolId/status), so coupons are no longer
    // client-readable by ordinary users. Buyer-side validation goes through the
    // getPoolQuote callable, which returns only sanitized coupon state. The admin
    // coupon manager + Monetization accounting tab read as SUPER_ADMIN.
    match /coupons/{couponId} {
      allow read: if isSuperAdmin();
      // Server-only (adminManageCoupon, Admin SDK bypasses rules) — audited writes.
      allow write: if false;
    }

    // COUPON TEMPLATES — reusable coupon definitions (Black Friday / Pre-Season).
    // SUPER_ADMIN reads (powers the Monetization > Templates tab); all writes go
    // through the couponTemplates callables (Admin SDK), audited.
    match /couponTemplates/{templateId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // CHECKOUT SESSIONS — pending billable snapshot + coupon reservation linkage
    // written at checkout by createCheckoutSession (Admin SDK) and cleared by the
    // webhook. Server-only; no client access (holds nothing the client needs, and
    // exposing it would leak reservation state).
    match /checkoutSessions/{reservationId} {
      allow read, write: if false;
    }

    // MONETIZATION ALERTS — coupon-abuse / refund / dispute / double-charge review
    // items. Computed by the monetizationAlerts job + written by the money webhook
    // (Admin SDK). SUPER_ADMIN reads the alert center; writes functions-only. The
    // acknowledgeMonetizationAlert callable flips status server-side.
    match /monetization_alerts/{alertId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // BUNDLES (canonical entitlements) — a commissioner's prepaid Pool Credits /
    // Unlimited Pass. Owner reads their own (the "My Bundles & Credits" dashboard
    // card); SUPER_ADMIN reads any (admin panel + accounting). Grants/revokes go
    // through the adminGrantEntitlement / adminRevokeEntitlement callables and the
    // Stripe webhook (Admin SDK) — no client writes.
    match /bundles/{bundleId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if false;

      // Per-credit redeemable docs. Readable only by the parent bundle's owner
      // (or SUPER_ADMIN); ownership is checked by get()-ing the parent bundle.
      match /credits/{creditId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/bundles/$(bundleId)).data.ownerId == request.auth.uid
            || isSuperAdmin()
          );
        allow write: if false;
      }
    }

    // REFERRALS — read-only for users (their own referrals), writes via Cloud Functions only
    match /referrals/{referralId} {
      allow read: if request.auth != null && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if request.auth != null && 
                    request.resource.data.referredUserId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.creditAwarded == false;
      allow update, delete: if false; // Only via Cloud Functions
    }

    // SETTINGS — read by anyone (for pricing page). Admin writes for general config,
    // but the money-config docs (billing_config, referral_config) are server-only
    // (adminSaveBillingConfig, Admin SDK) so every change is audited + validated.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin()
                   && settingId != 'billing_config'
                   && settingId != 'referral_config';
    }
  }
}
