rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROP QUESTIONS (Global Seeds)
    match /prop_questions/{questionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // NFL GAMES
    match /nfl_games/{gameId} {
      allow read: if true;
      allow write: if isSuperAdmin();

      // Live win probability (ADR 0004) — public game info, server-written only.
      match /winprob/{docId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // SITE-WIDE CONSENSUS (ADR 0004) — server-written post-lock aggregate (counts only, never
    // individual picks), scoped by pool type. Public read; write server-only.
    match /consensus/{weekKey}/{poolType}/{gameId} {
      allow read: if true;
      allow write: if false;
    }
    match /consensus/{weekKey} {
      allow read: if true;
      allow write: if false;
    }

    // PLAYER PROFILES (ADR 0004/0005) — sanitized public projection (only aggregate + scored
    // data; ZERO pool identifiers; never the private per-user docs). Public read;
    // server-written only.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;

      // ACHIEVEMENTS (ADR 0005 decision 5) — earned-achievement docs written only by the
      // future server-side achievements engine (Admin SDK). Same leak rule as the parent:
      // no pool identifiers on these docs.
      match /achievements/{achievementId} {
        allow read: if true;
        allow write: if false;
      }
    }

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'SUPER_ADMIN';
    }

    // EXPERT RESULTS (ADR 0005 Phase 6) — server-only grading store behind the
    // publicProfiles/expert_* projections. Clients read only the projection.
    match /expertResults/{expertId}/{document=**} {
      allow read, write: if false;
    }

    // POOLS:
    match /pools/{poolId} {
      // Allow GET by anyone (Guest Access via Link)
      allow get: if true;
      
      // Allow LIST (query) ONLY if:
      // 1. It is a single-document query (e.g. slug lookup)
      // 2. The pool is public
      // 3. The user is a participant, owner, or manager
      // 4. The user is a SuperAdmin
      allow list: if (request.query.limit <= 1) || 
                     (resource.data.isPublic == true) || 
                     (request.auth != null && (
                        resource.data.ownerId == request.auth.uid || 
                        resource.data.managerUid == request.auth.uid || 
                        request.auth.uid in resource.data.participantIds
                     )) || 
                     isSuperAdmin();

      // Delete: Owner only OR SuperAdmin
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.managerUid || 
        isSuperAdmin()
      );
      
      // Helper: is user the pool owner or manager?
      function isPoolManager() {
        return request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.managerUid;
      }

      // Protected fields that ONLY the Admin SDK (cloud functions) can write.
      function protectedFieldsUnchanged() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny([
          'managerUid', 'ownerId', 'createdAt', 'createdBy',
          'axisNumbers', 'squares', 'participants',
          'billing', // Billing status managed exclusively by Cloud Functions
          // Frozen weekly pick deadlines for Survivor/Margin. The server only ever
          // moves these EARLIER; a manager who could clear the map would erase the
          // record of a deadline that already passed and reopen that week by
          // widening the lock buffer.
          'hardLockByWeek'
        ]);
      }

      // Pool is in an editable state.
      // NOTE: 'PUBLISHED' is removed — status was renamed to 'OPEN'.
      function poolIsEditable() {
        return resource.data.get('status', 'DRAFT') in ['DRAFT', 'OPEN'];
      }

      // Is the caller a participant of this pool? (owner, manager, listed
      // participant, or SuperAdmin). Used to scope pool sub-resources (audit M2).
      function isPoolParticipant() {
        let pool = get(/databases/$(database)/documents/pools/$(poolId)).data;
        return request.auth != null && (
          pool.ownerId == request.auth.uid ||
          pool.managerUid == request.auth.uid ||
          (pool.get('participantIds', []) != null && request.auth.uid in pool.get('participantIds', [])) ||
          isSuperAdmin()
        );
      }

      // Update: Owner/Manager (filtered) OR SuperAdmin (unrestricted)
      allow update: if request.auth != null && (
        (isPoolManager() && protectedFieldsUnchanged() && poolIsEditable())
        || isSuperAdmin()
      );
                    
      // NO CREATE via Client (must use createPool function). The former sim-*
      // slug SUPER_ADMIN exception is GONE (PLAN-NFL-SIM-HARNESS Phase 5): every
      // simulator now creates through the real create callables with a
      // server-stamped simRunId trust anchor — no client path may mint pool docs.
      allow create: if false;

      // WINNERS (Subcollection)
      match /winners/{winnerId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // PAYMENT LEDGER (Subcollection) — append-only money audit trail.
      // Members of the pool can read it (shared record prevents "I paid you"
      // disputes); ALL writes go through Cloud Functions.
      match /payments/{paymentId} {
        allow read: if isPoolParticipant();
        allow write: if false; // Only via Cloud Functions
      }

      // PARTICIPANTS INDEX (Subcollection)
      match /participants/{participantId} {
        allow read: if request.auth != null && (
          request.auth.uid == participantId || 
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false; // Only via Cloud Functions
      }

      // SQUARE PRIVATE (Player PII — audit finding H1)
      // Contact info (email/phone/etc) is kept OUT of the public pool doc and
      // stored here so it is never exposed by the broad guest-link `get`.
      // Readable only by the pool owner/manager or a SuperAdmin. Writes are
      // Cloud Functions only (reserveSquare / updatePlayer / releaseSquares).
      match /squarePrivate/{squareId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false; // Only via Cloud Functions
      }

      // AUDIT LOGS
      match /audit/{auditId} {
        // Restrict reads to pool owner or super admin (audit logs contain UIDs and operation metadata)
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write, delete: if false; 
      }

      // AI COMMISSIONER
      match /ai_artifacts/{docId} {
        allow read: if true;
        allow write: if false;
      }
      
      match /ai_requests/{docId} {
         // Scoped to pool participants — requests can contain prompt/user context (audit M2).
         allow read: if isPoolParticipant();
         allow create: if request.auth != null
                       && request.resource.data.userId == request.auth.uid;
         allow update, delete: if false;
      }

      // ANNOUNCEMENTS
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
      }

      // BANTER MESSAGES
      // Reads scoped to pool participants (audit M2). authorUid must match the
      // authenticated user to prevent identity spoofing.
      match /messages/{messageId} {
        allow read: if isPoolParticipant();
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // PROP CARDS
      match /propCards/{userId} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin();
      }

      // WEEKLY RECAPS
      match /weekly_recaps/{recapId} {
        allow read: if true;
        allow write: if false; // Only via Cloud Functions
      }

      // BRACKET/PLAYOFF/NFL ENTRIES
      // A member always reads their OWN entry; owner/manager/admin retain management reads.
      // Non-owner PARTICIPANT reads split by pool type (ADR 0004 finding, closed by ADR 0005
      // Phase 2):
      // - NFL season types (PER_GAME/WEEKLY lock): an entry doc bundles ALL of a member's
      //   picks, so any pre-FINAL read can expose un-locked later picks. Participants read
      //   the server standings projection (/standings/current) and consensus instead; raw
      //   entries open up only when the pool is FINAL/COMPLETED.
      // - Single-lock types (bracket/playoff): post-lock full reveal is by design — the
      //   coarse locked/live gate stays.
      match /entries/{entryId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.ownerUid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin() ||
          (
            request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds &&
            (
              get(/databases/$(database)/documents/pools/$(poolId)).data.type in ['NFL_PICKEM', 'NFL_SURVIVOR', 'NFL_MARGIN']
                ? (
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'FINAL' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'COMPLETED'
                  )
                : (
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'LOCKED' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'LIVE' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'FINAL' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.status == 'COMPLETED' ||
                    get(/databases/$(database)/documents/pools/$(poolId)).data.isLocked == true
                  )
            )
          )
        );
        // Entries are written SERVER-SIDE ONLY (bracketEntries/poolOps callables;
        // simulators go through the runId-scoped simWriteEntries harness). The
        // former blanket isSuperAdmin() write — the Test Suite's raw-write door,
        // one bug away from corrupting a real pool's entries — is GONE
        // (PLAN-NFL-SIM-HARNESS Phase 5).
        allow write: if false;
      }

      // MEMBER RECORDS (roster + payment truth, ADR 0003)
      // Readable by any member of the pool + owner/manager/admin. Members may set ONLY
      // their own honor-system claim (memberReportedPaid/memberReportedAt) — the diff is
      // pinned so paidStatus and every other field stay server-only. Records are created
      // and deleted server-side (reconcileMembership / backfill migration).
      match /members/{memberUid} {
        allow read: if request.auth != null && (
          request.auth.uid == memberUid ||
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow update: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberReportedPaid', 'memberReportedAt']);
        allow create, delete: if false;
      }

      // STANDINGS PROJECTION (ADR 0005 Phase 2) — member-readable, reveal-safe scored
      // rows written by scoreNFLWeek (allowlist-built: no picks/confidence/usedTeams).
      // This is what member views read now that raw NFL entry reads are own-only pre-FINAL.
      match /standings/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // PAYOUT RECORDS (ADR 0005 Phase 4) — who-won-what, the source of truth for
      // Profit. Participant-readable (a pool's winners are inherent to pool play);
      // written only by the recordPoolPayouts callable.
      match /payoutRecords/{awardId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // Settlement state, notes, and actor metadata are NOT pool-public: only the
      // commissioner/manager/admin and the affected recipient may read.
      match /payoutRecordsPrivate/{awardId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // ROSTER SUMMARY (member-readable dues projection; server-written only)
      match /rosterSummary/{docId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // POOL CONSENSUS (ADR 0004) — server-written post-lock aggregate (counts only, no
      // individual picks). Readable by the pool's members/owner/admin; write server-only.
      match /consensus/{gameId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/pools/$(poolId)).data.participantIds ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow write: if false;
      }

      // SHARE CLICK TRACKING
      // Records share link clicks for pool manager analytics.
      // Writes require auth to prevent anonymous flooding.
      // Reads restricted to pool owner/super admin.
      match /shareClicks/{clickId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pools/$(poolId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pools/$(poolId)).data.managerUid == request.auth.uid ||
          isSuperAdmin()
        );
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
    
    // USERS & PARTICIPATIONS:
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());

      allow write: if request.auth != null && (
        (request.auth.uid == userId && (
          // Self-create default role. MEMBER is canonical (T6); PARTICIPANT kept
          // during the write-path migration + backfill so no ordering hazard.
          (resource == null && (request.resource.data.role == 'MEMBER' || request.resource.data.role == 'PARTICIPANT')) ||
          (resource != null && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'referralCredits', 'freePoolsAvailable',
            'poolCredits', 'activeBundleType', 'bundleExpiresAt'
          ]))
        )) ||
        isSuperAdmin()
      );

      // PARTICIPATIONS (Dashboard Index)
      match /participations/{poolId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only via Cloud Functions
      }

      // SEASON HISTORY (career record, written on pool completion)
      match /seasonHistory/{poolId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
        allow write: if false; // Only via Cloud Functions
      }
    }

    // POOL CLAIMS (Cross-Device Merge) — Cloud Functions only
    match /poolClaims/{claimId} {
      allow read, write: if false;
    }

    // SLUGS (For availability check)
    match /slugs/{slug} {
      allow get: if true;
    }

    // GLOBAL CONFIG
    // config/internal holds server-only secrets (email unsubscribe HMAC key) —
    // it must never be client-readable. Cloud Functions use the Admin SDK,
    // which bypasses these rules.
    match /config/{configId} {
      allow read: if configId != 'internal';
      allow write: if isSuperAdmin() && configId != 'internal';
    }

    // EMAIL OPT-OUTS — written only by the emailUnsubscribe function (Admin SDK)
    match /email_optouts/{docId} {
      allow read, write: if false;
    }

    // SYSTEM DOCUMENTS
    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // PLATFORM HEALTH — the health/latest snapshot doc (Overview API Status Center).
    // Written only by functions (getAdminHealthSnapshot callable + scheduledHealthCheck,
    // via Admin SDK, which bypasses rules); readable by SUPER_ADMIN only.
    match /health/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // SYSTEM LOGS
    // Create is functions-only (via the App-Check-gated logClientError callable +
    // server-side loggers, which use the Admin SDK and bypass rules). Previously
    // `create: if request.auth != null` let any authed user inject arbitrary docs
    // into this admin-visible log (log spoofing / stored-content injection).
    match /system_logs/{document=**} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ADMIN AUDIT LOG (T7) — forensic trail of admin actions, keyed by actor.
    // Written exclusively by Cloud Functions (writeAdminAudit); read by admins.
    match /admin_audit/{entryId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // BILLING CHARGES (T14) — platform revenue ledger (Stripe charges). Sensitive
    // company income, so admin-only read and functions-only write. NOT under the
    // public stats/* — that holds only prize volume/charity.
    match /billingCharges/{chargeId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ADMIN STATS (T14) — SUPER_ADMIN-only aggregates (e.g. revenue rollup).
    match /admin_stats/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // TOURNAMENTS (March Madness Data)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // STATS
    match /stats/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // POOL THEMES
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // EMAIL TRIGGERS — must go through Cloud Functions
    match /mail/{document=**} {
      allow create: if false;
    }

    // COUPONS — SUPER_ADMIN-only reads (ADR-0002): usageLog now holds per-user
    // reservation activity (userId/poolId/status), so coupons are no longer
    // client-readable by ordinary users. Buyer-side validation goes through the
    // getPoolQuote callable, which returns only sanitized coupon state. The admin
    // coupon manager + Monetization accounting tab read as SUPER_ADMIN.
    match /coupons/{couponId} {
      allow read: if isSuperAdmin();
      // Server-only (adminManageCoupon, Admin SDK bypasses rules) — audited writes.
      allow write: if false;
    }

    // COUPON TEMPLATES — reusable coupon definitions (Black Friday / Pre-Season).
    // SUPER_ADMIN reads (powers the Monetization > Templates tab); all writes go
    // through the couponTemplates callables (Admin SDK), audited.
    match /couponTemplates/{templateId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // CHECKOUT SESSIONS — pending billable snapshot + coupon reservation linkage
    // written at checkout by createCheckoutSession (Admin SDK) and cleared by the
    // webhook. Server-only; no client access (holds nothing the client needs, and
    // exposing it would leak reservation state).
    match /checkoutSessions/{reservationId} {
      allow read, write: if false;
    }

    // MONETIZATION ALERTS — coupon-abuse / refund / dispute / double-charge review
    // items. Computed by the monetizationAlerts job + written by the money webhook
    // (Admin SDK). SUPER_ADMIN reads the alert center; writes functions-only. The
    // acknowledgeMonetizationAlert callable flips status server-side.
    match /monetization_alerts/{alertId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // BUNDLES (canonical entitlements) — a commissioner's prepaid Pool Credits /
    // Unlimited Pass. Owner reads their own (the "My Bundles & Credits" dashboard
    // card); SUPER_ADMIN reads any (admin panel + accounting). Grants/revokes go
    // through the adminGrantEntitlement / adminRevokeEntitlement callables and the
    // Stripe webhook (Admin SDK) — no client writes.
    match /bundles/{bundleId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow write: if false;

      // Per-credit redeemable docs. Readable only by the parent bundle's owner
      // (or SUPER_ADMIN); ownership is checked by get()-ing the parent bundle.
      match /credits/{creditId} {
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/bundles/$(bundleId)).data.ownerId == request.auth.uid
            || isSuperAdmin()
          );
        allow write: if false;
      }
    }

    // REFERRALS — read-only for users (their own referrals), writes via Cloud Functions only
    match /referrals/{referralId} {
      allow read: if request.auth != null && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        isSuperAdmin()
      );
      allow create: if request.auth != null && 
                    request.resource.data.referredUserId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.creditAwarded == false;
      allow update, delete: if false; // Only via Cloud Functions
    }

    // SETTINGS — read by anyone (for pricing page). Admin writes for general config,
    // but the money-config docs (billing_config, referral_config) are server-only
    // (adminSaveBillingConfig, Admin SDK) so every change is audited + validated.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin()
                   && settingId != 'billing_config'
                   && settingId != 'referral_config';
    }
  }
}
