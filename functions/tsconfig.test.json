{
    // Type-check-only config: tsconfig.json (the deploy build) PLUS src/__tests__,
    // which that file excludes so test output never reaches Cloud Functions.
    // `npm run typecheck` runs this one, so the tests keep the type coverage they
    // had before the exclusion — it is a strict superset of the build's file set
    // with identical compilerOptions, so every error the build would report is
    // reported here too.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // Tests import their subjects from src/, so the emit-layout pin the build
        // needs would flag every test file as outside rootDir. Nothing is emitted
        // here, so drop it.
        "rootDir": "."
    },
    "include": [
        "src"
    ],
    // `exclude` replaces rather than merges, so the build's exclusion of
    // src/__tests__ is deliberately NOT inherited — that is the point of this file.
    //
    // fixtureMatrix imports the repo-root src/utils/ scenario runner, i.e. outside
    // functions/ entirely. vitest compiles it itself (vitest.emulator.config.ts);
    // tsc has never seen it, and pulling it in would drag repo-root sources into
    // this program under the wrong compilerOptions.
    "exclude": [
        "src/__tests__/emulator/fixtureMatrix.emulator.test.ts"
    ]
}
