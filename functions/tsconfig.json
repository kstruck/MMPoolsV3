{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "lib",
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "target": "es2017",
        "esModuleInterop": true,
        "moduleResolution": "node"
    },
    "compileOnSave": true,
    "include": [
        "src"
    ],
    "exclude": [
        "src/__tests__/emulator/fixtureMatrix.emulator.test.ts"
    ]
}
