{
    "id": "nfl-pickem-basic",
    "name": "Pick'em Basic (Straight)",
    "description": "One week, three games (one MNF): straight picks, weekly points, winner, recap + MNF tiebreaker",
    "poolType": "NFL_PICKEM",
    "poolConfig": {
        "name": "Sim Pick'em Basic",
        "type": "NFL_PICKEM",
        "settings": {
            "entryFee": 0,
            "lockMode": "PER_GAME",
            "payoutMode": "SEASON",
            "pickMode": "STRAIGHT",
            "confidenceMode": false,
            "payouts": { "places": [], "bonuses": [] }
        }
    },
    "nflGames": [
        { "week": 1, "home": "KC", "away": "BUF", "homeScore": 27, "awayScore": 24 },
        { "week": 1, "home": "SF", "away": "DAL", "homeScore": 30, "awayScore": 10 },
        { "week": 1, "home": "DET", "away": "GB", "homeScore": 20, "awayScore": 17, "isMonday": true }
    ],
    "scoreWeeks": [1],
    "testEntries": [
        {
            "userName": "Alice",
            "pickemPicks": { "1": { "g1": "KC", "g2": "SF", "g3": "DET" } },
            "weeklyTiebreakers": { "1": 38 }
        },
        {
            "userName": "Bob",
            "pickemPicks": { "1": { "g1": "KC", "g2": "SF", "g3": "GB" } },
            "weeklyTiebreakers": { "1": 30 }
        },
        {
            "userName": "Carol",
            "pickemPicks": { "1": { "g1": "BUF", "g2": "DAL", "g3": "GB" } },
            "weeklyTiebreakers": { "1": 37 }
        }
    ],
    "assertions": [
        { "type": "nflEntryCount", "expected": 3, "message": "Should have 3 pick'em entries" },
        { "type": "nflWeeklyPoints", "userName": "Alice", "week": 1, "expected": 3, "message": "Alice week 1 = 3 (all correct)" },
        { "type": "nflWeeklyPoints", "userName": "Carol", "week": 1, "expected": 0, "message": "Carol week 1 = 0 (all wrong)" },
        { "type": "nflTotalScore", "userName": "Bob", "expected": 2, "message": "Bob total = 2 (KC, SF correct; GB wrong)" },
        { "type": "nflWinner", "expected": "Alice", "message": "Alice should lead the pool with 3 points" },
        { "type": "recapExists", "week": 1, "expected": true, "message": "Week 1 recap should be generated" },
        { "type": "recapClosestTiebreaker", "week": 1, "expected": "Carol", "message": "Carol's 37 hits the MNF total (20+17) exactly" }
    ]
}
