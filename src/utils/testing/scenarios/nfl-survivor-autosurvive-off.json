{
    "id": "nfl-survivor-autosurvive-off",
    "name": "Survivor Auto-Survive Exemption OFF (edge)",
    "description": "Same exhausted-teams setup as nfl-survivor-autosurvive, but the exemption is DISABLED: Alice's missing pick is an auto-strike and eliminates her (sudden death). Expectations hand-verified.",
    "poolType": "NFL_SURVIVOR",
    "poolConfig": {
        "name": "Sim Survivor AutoSurvive OFF",
        "type": "NFL_SURVIVOR",
        "settings": {
            "entryFee": 0,
            "maxStrikes": 0,
            "maxRebuys": 0,
            "rebuyDeadlineWeek": 0,
            "rebuyCost": 0,
            "pickLosersMode": false,
            "autoSurviveExemptionEnabled": false,
            "payouts": { "places": [], "bonuses": [] }
        }
    },
    "nflGames": [
        { "week": 1, "home": "KC", "away": "BUF", "homeScore": 27, "awayScore": 24 },
        { "week": 1, "home": "SF", "away": "DAL", "homeScore": 30, "awayScore": 10 }
    ],
    "scoreWeeks": [1],
    "testEntries": [
        { "userName": "Alice", "survivorPicks": {}, "usedTeams": ["KC", "BUF", "SF", "DAL"] },
        { "userName": "Bob", "survivorPicks": { "1": "SF" }, "usedTeams": ["KC"] }
    ],
    "assertions": [
        { "type": "survivorStatus", "userName": "Alice", "expected": "ELIMINATED", "message": "No exemption: missing pick auto-strikes and eliminates" },
        { "type": "survivorStrikes", "userName": "Alice", "expected": 1, "message": "Alice strikes = 1" },
        { "type": "standingsRow", "userName": "Alice", "expected": { "status": "ELIMINATED", "eliminatedWeek": 1, "exemptWeeks": [] }, "message": "Eliminated week 1, no exemption recorded" },
        { "type": "survivorStatus", "userName": "Bob", "expected": "ALIVE", "message": "Bob survives normally" }
    ]
}
