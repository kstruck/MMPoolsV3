{
    "id": "nfl-buyflow-free-cap",
    "name": "Buy-flow: Free Plan Join Cap (item 15)",
    "description": "Free-plan pools cap at 10 participants. The creator holds slot 1; nine joins fill the pool; the 10th joiner (11th participant) is rejected through the REAL join flow. The expected text is MEMBER-facing (T6b/G9): the old message explained the platform's billing tiers to an invitee who has no billing relationship with us.",
    "poolType": "NFL_PICKEM",
    "createViaCallable": true,
    "poolConfig": {
        "name": "Sim Buyflow Cap",
        "type": "NFL_PICKEM",
        "settings": {
            "entryFee": 0,
            "lockMode": "PER_GAME",
            "payoutMode": "SEASON",
            "pickMode": "STRAIGHT",
            "confidenceMode": false,
            "payouts": { "places": [], "bonuses": [] }
        }
    },
    "nflGames": [
        { "week": 1, "home": "KC", "away": "BUF", "homeScore": 0, "awayScore": 0, "status": "SCHEDULED", "startOffsetMs": 7200000 }
    ],
    "lifecycleOps": [
        { "op": "join", "userNames": ["j01", "j02", "j03", "j04", "j05", "j06", "j07", "j08", "j09"] },
        { "op": "join", "userNames": ["j10"], "expectError": "This pool is full" }
    ],
    "assertions": [
        { "type": "submitRejected", "userName": "j10", "expected": "This pool is full", "message": "11th participant rejected by the free-plan cap" },
        { "type": "poolStatus", "field": "billing.status", "expected": "free", "message": "Pool is (and stays) on the free plan" },
        { "type": "nflEntryCount", "expected": 0, "message": "Joins only — no entries written" }
    ]
}
