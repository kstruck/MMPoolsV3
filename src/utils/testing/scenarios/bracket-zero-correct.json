{
    "id": "bracket-zero-correct",
    "name": "Bracket: Zero Correct Picks",
    "description": "Entry where all picks are wrong — score should be exactly 0",
    "poolType": "BRACKET",
    "poolConfig": {
        "name": "Zero Score Pool",
        "type": "BRACKET",
        "scoringSystem": "CLASSIC",
        "entryFee": 10
    },
    "testEntries": [
        {
            "userName": "Unlucky",
            "picks": {
                "slot-g1": "team2",
                "slot-g2": "team3",
                "slot-g3": "team4"
            },
            "tiebreakerPrediction": 140
        }
    ],
    "tournamentResults": [
        {
            "gameId": "g1",
            "homeTeamId": "team1",
            "awayTeamId": "team2",
            "winnerId": "team1",
            "round": 1
        },
        {
            "gameId": "g2",
            "homeTeamId": "team3",
            "awayTeamId": "team4",
            "winnerId": "team4",
            "round": 1
        },
        {
            "gameId": "g3",
            "homeTeamId": "team1",
            "awayTeamId": "team4",
            "winnerId": "team1",
            "round": 2
        }
    ],
    "assertions": [
        {
            "type": "bracketEntryCount",
            "expected": 1,
            "message": "Should have 1 bracket entry"
        },
        {
            "type": "bracketTopScore",
            "expected": 0,
            "message": "Score should be 0 (all picks wrong: picked team2/team3/team4 but winners were team1/team4/team1)"
        }
    ]
}