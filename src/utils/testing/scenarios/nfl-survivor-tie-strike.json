{
    "id": "nfl-survivor-tie-strike",
    "name": "Survivor Tie Game = Strike (edge)",
    "description": "A tied game STRIKES the picker in standard mode (docs/NFL_POOLS_README.md §2: \"If the team loses/ties, you take a strike\"). This fixture also caught a Scenario Oracle bug — its original 'ties survive' rule contradicted the product doc. Expectations hand-verified against the doc.",
    "poolType": "NFL_SURVIVOR",
    "poolConfig": {
        "name": "Sim Survivor Tie",
        "type": "NFL_SURVIVOR",
        "settings": {
            "entryFee": 0,
            "maxStrikes": 0,
            "maxRebuys": 0,
            "rebuyDeadlineWeek": 0,
            "rebuyCost": 0,
            "pickLosersMode": false,
            "autoSurviveExemptionEnabled": false,
            "payouts": { "places": [], "bonuses": [] }
        }
    },
    "nflGames": [
        { "week": 1, "home": "KC", "away": "BUF", "homeScore": 21, "awayScore": 21 },
        { "week": 1, "home": "SF", "away": "DAL", "homeScore": 30, "awayScore": 10 }
    ],
    "scoreWeeks": [1],
    "testEntries": [
        { "userName": "Alice", "survivorPicks": { "1": "KC" } },
        { "userName": "Bob", "survivorPicks": { "1": "SF" } }
    ],
    "assertions": [
        { "type": "survivorStatus", "userName": "Alice", "expected": "ELIMINATED", "message": "Tie = strike; sudden death eliminates Alice" },
        { "type": "survivorStrikes", "userName": "Alice", "expected": 1, "message": "Alice strikes = 1" },
        { "type": "gradedPick", "userName": "Alice", "week": 1, "expected": "STRUCK", "message": "Alice wk1 (tie) graded STRUCK" },
        { "type": "survivorStatus", "userName": "Bob", "expected": "ALIVE", "message": "Bob (SF won) survives" }
    ]
}
