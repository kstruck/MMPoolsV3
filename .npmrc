# Match the Docker build (Dockerfile: `npm ci --legacy-peer-deps`) so plain
# `npm ci` in CI resolves the same tree. Concretely needed for
# eslint-plugin-jsx-a11y@6, whose peer range stops at eslint 9 while this repo
# is on eslint 10 — the flat-config plugin works fine there; the range is just
# conservative. Remove when a jsx-a11y release peers to eslint 10.
legacy-peer-deps=true
