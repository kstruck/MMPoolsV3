# E2E-only config: vite --mode e2e loads this instead of .env. Points the app
# at local Firebase emulators (see src/firebase.ts). Values are placeholders —
# the emulators don't validate them, they only need to be present and the
# projectId must match the emulator's --project flag (demo-mmp).
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mmp
VITE_FIREBASE_STORAGE_BUCKET=demo-mmp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true
