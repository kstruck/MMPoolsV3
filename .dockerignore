node_modules
# Nested installs too. A bare `node_modules` matches the ROOT one only, and
# `scripts/` stays in the build context, so `scripts/agent/node_modules` (the
# Claude Agent SDK and its native binary) rode into `COPY . .` on any machine
# that had run `npm --prefix scripts/agent ci`.
**/node_modules
dist
.git
.gitignore
.env

# 2026-08-23 build audit: `COPY . .` invalidated its layer whenever any of the
# ~150 repo-root planning docs changed, forcing a full rebuild. None of the
# below is read by tsc/vite/prerender (the www build), so keep it out of the
# build context. nginx.conf, src/, public/, shared/, scripts/, index.html and
# the tsconfigs stay IN.
*.md
docs
functions
tests
e2e
.claude
.github
.husky
graphify-out
playwright.config.ts
test-results
playwright-report
