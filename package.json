{
  "name": "march-melee-pools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:backend": "firebase deploy --only functions,firestore:rules",
    "deploy:hosting": "firebase deploy --only hosting",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.556.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^2.0.5",
    "react-is": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.14.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.2.4",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "minimatch": ">=10.2.4",
    "@tootallnate/once": ">=3.0.1",
    "express-rate-limit": ">=8.2.2"
  }
}