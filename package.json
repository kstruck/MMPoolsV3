{
  "name": "march-melee-pools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "prerender": "tsx scripts/prerender.ts",
    "build:static": "npm run build && npm run prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node functions/scripts/copy-shared.mjs && vitest run",
    "deploy:backend": "npx firebase deploy --only functions,firestore:rules,firestore:indexes --project gridiron-gamble-uzuqo",
    "deploy:hosting": "npm run build:static && npx firebase deploy --only hosting",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/react": "^10.70.0",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.556.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.86.0",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.28.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@tootallnate/once": ">=3.0.1",
    "express-rate-limit": ">=8.2.2",
    "uuid": ">=11.1.1",
    "qs": ">=6.15.2",
    "websocket-driver": ">=0.7.5",
    "brace-expansion": "^5.0.9"
  }
}
